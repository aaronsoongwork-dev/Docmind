LLM_PROVIDER=anthropic          # anthropic | openai | ollama
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=sk-ant-...
EMBEDDINGS_PROVIDER=huggingface # huggingface | fake (tests only)
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base   # set to "none" to disable
CHROMA_DIR=./chroma_db
CHUNK_SIZE=800
TOP_K=4
FETCH_K=15
LLM_TIMEOUT=30
