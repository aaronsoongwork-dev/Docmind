# --- LLM ---
LLM_PROVIDER=gemini             # gemini | ollama | anthropic | openai
LLM_MODEL=gemini-2.5-flash      # for ollama e.g. qwen2.5:3b
LLM_FALLBACK_MODEL=             # optional: used automatically if the main model errors (e.g. 503)
GOOGLE_API_KEY=
LLM_TIMEOUT=30
# OLLAMA_BASE_URL=http://localhost:11434

# --- retrieval ---
EMBEDDINGS_PROVIDER=huggingface # huggingface | fake (tests only)
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5   # or a fine-tuned folder, e.g. models/docmind-embed-ft
RERANKER_MODEL=BAAI/bge-reranker-base     # "none" to disable
CHROMA_DIR=./chroma_db
CHUNK_SIZE=800
TOP_K=4
FETCH_K=15

# --- app ---
DATABASE_URL=sqlite:///./docmind.db       # Postgres: postgresql+psycopg://user:pass@host:5432/docmind
AGENT_MAX_STEPS=4
